{
  // Display name for this crew
  "name": "software_engineering_team",
  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": [
    "repository_research_analyst",
    "software_architect",
    "technical_documentation_specia",
    "backend_software_engineer",
    "frontend_software_engineer",
    "database_engineer",
    "senior_code_reviewer",
    "qa__test_engineer"
  ],
  // Task definitions — executed in order for sequential process
  "tasks": [
    {
      // Task identifier
      "name": "repository_analysis",
      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Analyze the GitHub repository located at {repository_url}. First use CloneRepositoryTool to clone the repository. Then use RepositoryScannerTool to identify the programming language, framework, package manager, entry point, Docker support, and GitHub Actions. Next, use CodeSearchTool to locate authentication, database, API routes, configuration, models, and services. Finally, produce a comprehensive technical report summarizing the repository architecture and important implementation details.",
      // Clear definition of what the output should look like
      "expected_output": "A detailed repository analysis report containing the project's purpose, programming language, frameworks, folder structure, architecture overview, dependencies, entry points, important modules, configuration files, coding patterns, potential risks, and recommendations for downstream engineering tasks.",
      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,
      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},
      // Which agent handles this task
      "agent": "repository_research_analyst"
      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    },
    {
      // Task identifier
      "name": "architecture_planning",
      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Analyze the repository research report generated by the Repository Research Analyst. Identify the software architecture, component interactions, design patterns, dependencies between modules, technical risks, and implementation strategy. Produce a detailed engineering plan that downstream implementation agents can follow safely.",
      // Clear definition of what the output should look like
      "expected_output": "A comprehensive software architecture and implementation plan describing the system design, module relationships, implementation steps, affected components, technical risks, and recommended development sequence.",
      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,
      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},
      // Which agent handles this task
      "agent": "software_architect",
      // Task outputs used as context
      "context": [
        "repository_analysis"
      ]
      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    },
    {
      // Task identifier
      "name": "backend_implementation",
      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Using the software architecture plan, implement the required backend changes by first locating relevant backend files using CodeSearchTool, reading their complete contents using ReadFileTool, analyzing the existing implementation, modifying only the necessary code while preserving the project's architecture and coding style, writing the updated implementation back using WriteFileTool, avoiding placeholder or pseudocode, and finally providing a summary of all modified files, business logic changes, APIs updated, and assumptions made. Additionally, implement the following requested change: {implementation_request}.",
      // Clear definition of what the output should look like
      "expected_output": "A production-ready backend implementation report containing the list of modified files, implementation summary, business logic changes, APIs added or updated, assumptions made, and confirmation that all modified files were successfully written back to the repository using WriteFileTool.",
      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,
      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},
      // Which agent handles this task
      "agent": "backend_software_engineer",
      // Task outputs used as context
      "context": [
        "architecture_planning"
      ]
      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    },
    {
      // Task identifier
      "name": "frontend_implementation",
      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Based on the software architecture plan, implement the required frontend changes by first locating relevant frontend files using CodeSearchTool, reading their complete contents using ReadFileTool, analyzing the existing implementation, modifying only the necessary code while preserving the project's architecture and coding style, and writing the updated implementation back using WriteFileTool. Avoid placeholder or pseudocode.",
      // Clear definition of what the output should look like
      "expected_output": "A frontend implementation report describing updated UI components, API integrations, affected files, implementation summary, and confirmation that all modified files were successfully written using WriteFileTool.",
      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,
      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},
      // Which agent handles this task
      "agent": "frontend_software_engineer",
      // Task outputs used as context
      "context": [
        "architecture_planning"
      ]
      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    },
    {
      // Task identifier
      "name": "database_implementation",
      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Review the software architecture plan and determine whether database schema, queries, migrations, indexes, or data models require changes. Use CodeSearchTool to locate existing database files, ReadFileTool to read them, implement the required modifications, and WriteFileTool to save the changes. Design scalable and efficient database modifications while maintaining data integrity, consistency, and performance.",
      // Clear definition of what the output should look like
      "expected_output": "A database implementation report containing schema changes, migration recommendations, query optimizations, indexing strategy, affected database components, and confirmation that all modified files were written using WriteFileTool.",
      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,
      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},
      // Which agent handles this task
      "agent": "database_engineer",
      "context": [
        "architecture_planning"
      ]
      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    },
    {
      // Task identifier
      "name": "code_review",
      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Review the backend, frontend, and database implementations for correctness, maintainability, security, performance, coding standards, and architectural compliance. Identify issues, recommend improvements, and verify that the implementation follows the approved architecture.",
      // Clear definition of what the output should look like
      "expected_output": "A comprehensive code review report highlighting implementation quality, security concerns, performance observations, coding standard violations, architectural compliance, and recommended improvements.",
      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,
      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},
      // Which agent handles this task
      "agent": "senior_code_reviewer",
      // Task outputs used as context
      "context": [
        "frontend_implementation",
        "database_implementation",
        "backend_implementation"
      ]
      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    },
    {
      // Task identifier
      "name": "testing",
      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Design and execute a comprehensive testing strategy for the reviewed implementation. Identify functional issues, edge cases, regression risks, and verify that the proposed changes satisfy the implementation requirements.",
      // Clear definition of what the output should look like
      "expected_output": "A testing report containing test scenarios, validation results, identified issues, regression risks, failed cases if any, and recommendations before deployment.",
      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,
      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},
      // Which agent handles this task
      "agent": "qa__test_engineer",
      // Task outputs used as context
      "context": [
        "code_review"
      ]
      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    },
    {
      // Task identifier
      "name": "documentation",
      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Compile the outputs from all previous engineering tasks into a professional technical document. Produce clear documentation describing the repository analysis, architecture, implementation summary, code review findings, testing results, and final engineering recommendations.",
      // Clear definition of what the output should look like
      "expected_output": "A complete engineering report containing the repository analysis, software architecture, implementation summary, code review findings, testing results, technical recommendations, and developer documentation suitable for future maintenance.",
      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,
      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},
      // Which agent handles this task
      "agent": "technical_documentation_specia",
      // Task outputs used as context
      "context": [
        "code_review",
        "testing"
      ]
      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
  ],
  // Execution process
  // "sequential" — tasks run in order, each receiving prior task outputs
  // "hierarchical" — a manager agent delegates tasks (requires manager_llm)
  "process": "sequential",
  // Enable verbose logging during execution
  "verbose": true,
  // Enable crew memory — persists context and learnings across tasks
  "memory": false,
  "output_log_file": "crew.log",
  // Automatically plan the execution strategy before running tasks
  // "planning": false,
  // LLM for the planning step (used when planning is true)
  // "planning_llm": "openai/gpt-4o",
  // LLM for the manager agent (required when process is "hierarchical")
  // "manager_llm": "openai/gpt-4o",
  // Crew-level LLM fields also accept object form for custom endpoints
  // "chat_llm": {"model": "llama3", "provider": "ollama", "base_url": "http://localhost:11434"},
  // Advanced crew options:
  // Docs: https://docs.crewai.com/concepts/crews
  // For hierarchical crews, manager_agent can reference an agents/<name>.jsonc file
  // that is not included in the "agents" list.
  // "manager_agent": "repository_research_analyst",
  // "before_kickoff_callbacks": [{"python": "my_project.callbacks.before_kickoff"}],
  // "after_kickoff_callbacks": [{"python": "my_project.callbacks.after_kickoff"}],
  // "function_calling_llm": "openai/gpt-4o-mini",
  // "max_rpm": null,
  // "cache": true,
  // "knowledge_sources": [],
  // "embedder": {},
  // "output_log_file": "crew.log",
  // "stream": false,
  // "tracing": false,
  // "security_config": {},
  // Optional runtime input defaults.
  // Use {placeholder} in agent or task text, for example:
  // "description": "Research {topic} and write a brief"
  // `crewai run` prompts for any placeholders missing from this object.
  "inputs": {
    "repository_url": "https://github.com/bradtraversy/node_jwt_example",
    "implementation_request": "Add a new protected GET /api/users/profile endpoint directly to app.js. This endpoint should require JWT authentication (use the existing verifyToken middleware), and return the authenticated user's id, username, and email. Read app.js first using ReadFileTool to understand the current implementation, modify app.js to include the new endpoint, and write the complete updated content back to app.js using WriteFileTool."
  }
}